# --------
# Data / Outputs (usually large or private)
# --------
/data/
/_sync/
/dataset/

# --------
# Experiment artifacts (keep small metrics in git; avoid large weights/samples)
# --------
# Model checkpoints / weights
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.ckpt
outputs/**/*.safetensors
outputs/**/*.onnx
outputs/**/checkpoints/
outputs/**/ckpts/
outputs/**/wandb/
outputs/**/tensorboard/
outputs/**/events.out.tfevents*

# Large intermediate formats (prefer regenerate / keep outside git)
outputs/**/*.parquet
outputs/**/*.feather
outputs/**/*.pkl
outputs/**/*.pickle
outputs/**/*.h5
outputs/**/*.hdf5

# Sample-level exports (often huge); keep aggregated portraits/metrics instead
outputs/**/samples*.csv
outputs/**/samples*.csv.gz
outputs/**/samples*.npz

# --------
# Python / Jupyter
# --------
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --------
# Virtual env / Conda
# --------
.venv/
venv/
ENV/
.env
.env.*
.conda/
conda/

# --------
# Build artifacts
# --------
build/
dist/
*.egg-info/

# --------
# Logs
# --------
*.log

# Allow experiment logs under outputs/ to be versioned when needed.
!outputs/**/*.log

# Keep outputs lightweight for syncing (PDF can be regenerated from scripts).
outputs/**/*.pdf

# --------
# OS / Editors
# --------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
